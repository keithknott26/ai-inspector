# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 130

[{CMakeLists.txt,*.cmake}]
# Wireshark's plugin CMake uses tabs
indent_style = tab
indent_size = 8

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.sh]
indent_size = 2

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
